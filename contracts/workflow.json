    {"id": "after", "phase": "6", "plugin": "a11y-capture", "provider": "capture", "gates": ["claimOwned", "evaluatorOwned", "worktreeOwned", "runtimeVerified", "realAssistiveTechnology", "scenarioMatched", "exactHeadMatched", "artifactsHashed"]},
