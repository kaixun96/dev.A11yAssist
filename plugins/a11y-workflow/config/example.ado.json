{
  "schemaVersion": 1,
  "owner": "your-caller-namespace",
  "stateRoot": "C:\\YourPrivateDirectory\\a11y-operations",
  "providers": {
    "intake": {
      "kind": "ado",
      "organization": "https://dev.azure.com/YOUR-ORGANIZATION",
      "project": "YOUR-PROJECT",
      "authorizationEnvironmentVariable": "A11Y_ADO_AUTHORIZATION"
    },
    "publish": {
      "kind": "ado",
      "organization": "https://dev.azure.com/YOUR-ORGANIZATION",
      "project": "YOUR-PROJECT",
      "repositoryId": "YOUR-REPOSITORY-ID",
      "authorizationEnvironmentVariable": "A11Y_ADO_AUTHORIZATION"
    },
    "bugs": {
      "kind": "ado",
      "organization": "https://dev.azure.com/YOUR-ORGANIZATION",
      "project": "YOUR-PROJECT",
      "descriptionField": "System.Description",
      "authorizationEnvironmentVariable": "A11Y_ADO_AUTHORIZATION",
      "attachmentUpload": {
        "mode": "simple",
        "maxTotalBytes": 134217728,
        "maxFileBytes": 134217728,
        "chunkSizeBytes": 8388608,
        "timeoutSeconds": 120
      }
    }
  }
}
