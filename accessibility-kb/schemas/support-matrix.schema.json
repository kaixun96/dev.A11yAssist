{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product accessibility support matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "owner", "sourceIds", "products"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["awaiting-official-source", "sourced"]},
    "owner": {"type": "string", "minLength": 1},
    "sourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "products": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "source", "rules"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source": {
            "type": "object", "additionalProperties": false, "required": ["id", "locator", "revision"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "minLength": 1}
            }
          },
          "rules": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["requirementId", "applicability", "supportStatus", "verificationStatus", "basis", "verificationEvidence", "exception"],
              "properties": {
                "requirementId": {"type": "string", "minLength": 1},
                "applicability": {"enum": ["applicable", "not-applicable", "undetermined"]},
                "supportStatus": {"enum": ["supported", "partial", "unsupported", "unknown"]},
                "verificationStatus": {"enum": ["verified", "unverified", "stale"]},
                "basis": {"type": "string", "minLength": 1},
                "verificationEvidence": {"type": ["string", "null"], "minLength": 1},
                "exception": {
                  "anyOf": [
                    {"type": "null"},
                    {"type": "object", "additionalProperties": false, "required": ["reference", "scope", "expires"],
                      "properties": {
                        "reference": {"type": "string", "minLength": 1},
                        "scope": {"type": "string", "minLength": 1},
                        "expires": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}