{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared accessibility knowledge package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "dependencies", "sources", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type":"string","pattern":"^[a-z][a-z0-9-]*$"},
    "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "dependencies": {"type":"object","propertyNames":{"pattern":"^[a-z][a-z0-9-]*$"},"additionalProperties":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"}},
    "sources": {
      "type":"array",
      "items": {
        "type":"object","additionalProperties":false,
        "required":["id","authority","status","locator","revision","note"],
        "properties": {
          "id":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},
          "authority":{"enum":["company-requirements","normative-standard","informative-guidance","component-contract","product-support","historical-reference"]},
          "status":{"enum":["connection-pending","review-pending","historical","reviewed"]},
          "locator":{"type":["string","null"],"minLength":1},
          "revision":{"type":["string","null"],"minLength":1},
          "note":{"type":"string","minLength":1}
        }
      }
    },
    "entries": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["id","path","kind","status","owner","appliesTo","sourceIds","relations"],
        "properties": {
          "id":{"type":"string","pattern":"^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
          "path":{"type":"string","minLength":1},
          "kind":{"enum":["topic","requirement-guidance","implementation-contract","analysis","verification","case","procedure","product-profile"]},
          "discoveryTags":{"type":"array","uniqueItems":true,"minItems":1,"maxItems":3,"items":{"enum":["pattern","fix","example"]}},
          "status":{"enum":["draft","approved","deprecated"]},
          "owner":{"type":"string","minLength":1},
          "appliesTo":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "sourceIds":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "relations":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "deprecatedBy":{"type":"string","minLength":1},
          "dataSchema":{"enum":["support-matrix"]},
          "review":{
            "type":"object","additionalProperties":false,"required":["reviewer","date","evidence"],
            "properties":{
              "reviewer":{"type":"string","minLength":1},
              "date":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
              "evidence":{"type":"string","minLength":1}
            }
          }
        }
      }
    }
  }
}