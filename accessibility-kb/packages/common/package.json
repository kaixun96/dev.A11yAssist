    {"id": "aria", "authority": "normative-standard", "status": "review-pending", "locator": "https://www.w3.org/TR/wai-aria-1.2/", "revision": null, "note": "Role, state and property definitions; review exact applicable provisions."},
    {"id": "html", "authority": "normative-standard", "status": "review-pending", "locator": "https://html.spec.whatwg.org/", "revision": null, "note": "Native semantics; living source must be revision-bound for qualification."},
    {"id": "apg", "authority": "informative-guidance", "status": "review-pending", "locator": "https://www.w3.org/WAI/ARIA/apg/", "revision": null, "note": "Patterns and examples, not a replacement for normative requirements."},
    {"id": "wcag-understanding", "authority": "informative-guidance", "status": "review-pending", "locator": "https://www.w3.org/WAI/WCAG22/Understanding/", "revision": null, "note": "Explanation and technique selection, not a mandatory single implementation."},
    {"id": "agentow-accessibility", "authority": "historical-reference", "status": "historical", "locator": "https://github.com/kaixun96/dev.AgentOW/blob/7896845e51d75b0b9d632a2fd61876bc2f556ea5/copilot/skills/ow-review/references/accessibility.md", "revision": "7896845e51d75b0b9d632a2fd61876bc2f556ea5", "note": "Pinned basis for review triggers, rendered semantics, heading-outline reasoning, async outcomes, focus, content and verification. Product APIs and historical severity labels remain host-scoped; file/schema mechanics and overbroad contrast generalizations are not Common standards."},
    {"id": "agentow-evaluator", "authority": "historical-reference", "status": "historical", "locator": "https://github.com/kaixun96/dev.AgentOW/blob/7896845e51d75b0b9d632a2fd61876bc2f556ea5/copilot/agents/a11y-evaluator.agent.md", "revision": "7896845e51d75b0b9d632a2fd61876bc2f556ea5", "note": "Historical evidence interpretation: Voice Access overlay attribution, matched capture state, screen-reader recording quality and scenario/step comparison. Agent execution, validator commands and artifact schemas remain outside KB content."},
    {"id": "agentow-localization", "authority": "historical-reference", "status": "historical", "locator": "https://github.com/kaixun96/dev.AgentOW/blob/7896845e51d75b0b9d632a2fd61876bc2f556ea5/copilot/skills/ow-review/references/localization-and-formatting.md", "revision": "7896845e51d75b0b9d632a2fd61876bc2f556ea5", "note": "Entire historical reference read, lines 1-210. Scoped summaries cover complete visible/assistive messages, count/interval semantics, element placeholders, safe rich text, locale formatting, fallback and RTL exceptions. Product resource syntax, formatter APIs and approval locks are not Common standards; zero/plural wording follows the target locale. Current authority and redistribution review pending."},
    {"id": "agentow-reuse", "authority": "historical-reference", "status": "historical", "locator": "https://github.com/kaixun96/dev.AgentOW/blob/7896845e51d75b0b9d632a2fd61876bc2f556ea5/copilot/skills/ow-review/references/shared-utility-reuse.md", "revision": "7896845e51d75b0b9d632a2fd61876bc2f556ea5", "note": "Entire historical reference read, lines 1-198. Only contract-fit, formatter/utility ownership and behavioral-divergence lessons are generalized for accessibility. Package maps, review artifacts and severity policy remain outside Common. Historical, not current API/owner approval; redistribution review pending."},
    {"id": "agentow-replacement", "authority": "historical-reference", "status": "historical", "locator": "https://github.com/kaixun96/dev.AgentOW/blob/7896845e51d75b0b9d632a2fd61876bc2f556ea5/copilot/skills/ow-ref-replace-component/SKILL.md", "revision": "7896845e51d75b0b9d632a2fd61876bc2f556ea5", "note": "Entire historical skill read as data, lines 1-52. Generalized behavior regression inventory and matched comparison conditions only. No rollout, dependency, build, capture or release execution. Current component contract and redistribution review pending; no approval claimed."},
    {"id": "agentow-review-misses", "authority": "historical-reference", "status": "historical", "locator": "https://github.com/kaixun96/dev.AgentOW/blob/7896845e51d75b0b9d632a2fd61876bc2f556ea5/copilot/docs/review-misses.md", "revision": "7896845e51d75b0b9d632a2fd61876bc2f556ea5", "note": "Entire historical reference read, lines 1-81. Sanitized generalizations of inconsistent copies, incoherent first paint, self-attested checklist and parity calibration. Examples are hypothetical acceptance cases, not reproduced incidents or reviewer approval. Current applicability and redistribution review pending."},
    {"id": "agentow-review-issues", "authority": "historical-reference", "status": "historical", "locator": "https://github.com/kaixun96/dev.AgentOW/blob/7896845e51d75b0b9d632a2fd61876bc2f556ea5/copilot/skills/ow-review/references/common-review-issues.md", "revision": "7896845e51d75b0b9d632a2fd61876bc2f556ea5", "note": "Entire historical reference read, lines 1-366. Accessibility-relevant lifecycle, stale async work, cancellation, data-domain, cleanup and behavior-test lessons only; not a migration of general runtime or operational policy. Historical draft basis, current authority and redistribution review pending."},
    {"id": "agentow-architecture", "authority": "historical-reference", "status": "historical", "locator": "https://github.com/kaixun96/dev.AgentOW/blob/7896845e51d75b0b9d632a2fd61876bc2f556ea5/copilot/skills/ow-review/references/ux-architecture-and-bundle-boundaries.md", "revision": "7896845e51d75b0b9d632a2fd61876bc2f556ea5", "note": "Entire historical reference read, lines 1-60. Semantic/interaction/state ownership and preservation of loading/error/retry/focus across async boundaries only. File-size, bundle and review-severity policy excluded. Current applicability and redistribution review pending."},
    {"id": "agentow-graduation", "authority": "historical-reference", "status": "historical", "locator": "https://github.com/kaixun96/dev.AgentOW/blob/7896845e51d75b0b9d632a2fd61876bc2f556ea5/copilot/skills/ow-review/references/graduation.md", "revision": "7896845e51d75b0b9d632a2fd61876bc2f556ea5", "note": "Entire historical reference read as data, lines 1-762. Only behavior-preserving cleanup cautions about reconciliation/identity and prop-presence contracts inform accessibility regression cases. No graduation workflow, authorization, report schema or severity is adopted. Current applicability and redistribution review pending."},
    {"id": "agentow-size-regression", "authority": "historical-reference", "status": "historical", "locator": "https://github.com/kaixun96/dev.AgentOW/blob/7896845e51d75b0b9d632a2fd61876bc2f556ea5/copilot/skills/ow-review/references/size-regression.md", "revision": "7896845e51d75b0b9d632a2fd61876bc2f556ea5", "note": "Entire historical reference read as data, lines 1-226. Only required initialization, compatible runtime identity and loading-boundary risks are generalized into accessibility regression cases. Performance budgets, commands, packaging implementation and approval policy are not Common requirements. Current applicability and redistribution review pending."}
  ],
